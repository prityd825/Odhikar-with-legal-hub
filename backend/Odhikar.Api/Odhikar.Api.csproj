<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Odhikar.Api</RootNamespace>
    <AssemblyName>Odhikar.Api</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Odhikar.Application\Odhikar.Application.csproj" />
    <ProjectReference Include="..\Odhikar.Infrastructure\Odhikar.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fonts\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Automatically terminates any running Odhikar.Api instance before build to prevent file lock errors -->
  <Target Name="AutoKillRunningProcess" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -Command &quot;Get-Process -Name 'Odhikar.Api' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue&quot;"
          IgnoreExitCode="true" />
  </Target>

</Project>
